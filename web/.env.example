# Never commit real values. An Atlas mongodb+srv URI enables TLS by default.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/rootledger?retryWrites=true&w=majority
MONGODB_DB=rootledger
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
PORT=8787

# Browser-visible configuration. Restrict this key to your deployed domains and localhost.
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_BASE_URL=http://localhost:8000
